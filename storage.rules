rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read for all files (images shown to buyers)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow upload of listing photos without authentication
    // (farmers may not be logged in with Firebase Auth in this app)
    match /listing_photos/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
